# 工具站（https://tool.fologde.com）管理后台「系统 → OAuth 应用」创建应用后获得。
VITE_OAUTH_CLIENT_ID=tc_xxxx

# 仅本地开发需要：vite 中间件注入换令牌请求用（复制到 .env.local）。
# 线上密钥存 Cloudflare Pages 环境变量 OAUTH_CLIENT_SECRET
#（npx wrangler pages secret put OAUTH_CLIENT_SECRET --project-name=idea-store）。
OAUTH_CLIENT_SECRET=tcs_xxxx

# 可选：OAuth 授权服务器地址，默认 https://tool.fologde.com
# VITE_OAUTH_BASE_URL=https://tool.fologde.com
